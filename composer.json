{
    "name": "ranetrace/ranetrace-laravel",
    "description": "This package provides the integration for Ranetrace, a tool for monitoring your Laravel applications.",
    "keywords": [
        "ranetrace",
        "laravel",
        "ranetrace-laravel"
    ],
    "homepage": "https://github.com/ranetrace/ranetrace-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Ranetrace",
            "email": "contact@ranetrace.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0||^13.0",
        "jaybizzle/crawler-detect": "^1.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/mcp": "^0.7",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0",
        "pestphp/pest-plugin-browser": "^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "laravel/mcp": "Required for MCP server functionality (^0.7)"
    },
    "autoload": {
        "psr-4": {
            "Ranetrace\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ranetrace\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan boost:update --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --exclude-testsuite=Browser",
        "test-fast": "vendor/bin/pest --parallel --tia --exclude-testsuite=Browser",
        "test-browser": "vendor/bin/pest --testsuite=Browser",
        "test-coverage": "vendor/bin/pest --coverage --exclude-testsuite=Browser",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ranetrace\\Laravel\\RanetraceServiceProvider"
            ],
            "aliases": {
                "Ranetrace": "Ranetrace\\Laravel\\Facades\\Ranetrace"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
